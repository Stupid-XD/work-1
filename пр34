#include <iostream>
#include <string>
#include <Windows.h>
using namespace std;

int main() {
	SetConsoleCP(65001);
	SetConsoleOutputCP(65001);

	class Cat {
	private:
		string name;
		string color;
		string breed;
		int age;

	public:

		void setName(string n) {
			name = n;
		}

		string getName() {
			return name;
		}

		void setColor(string c) {
			color = c;
		}

		string getColor() {
			return color;
		}

		void setBreed(string b) {
			breed = b;
		}

		string getBreed() {
			return breed;
		}

		void setAge(int a) {
			age = a;
		}

		int getAge() {
			return age;
		}
	};

	int main(); {
		
		Cat Cat1;
		Cat Cat2;
		Cat Cat3;

		Cat1.setName("Муся");
		Cat1.setColor("Чёрный");
		Cat1.setBreed("Британская");
		Cat1.setAge(3);

		Cat2.setName("Барсик");
		Cat2.setColor("Рыжий");
		Cat2.setBreed("Сиамская");
		Cat2.setAge(4);

		Cat3.setName("Мурка");
		Cat3.setColor("Белый");
		Cat3.setBreed("Персидская");
		Cat3.setAge(5);

		cout << "[-] Программа \"коты\"" << endl;

		cout << "[1] Объект: " << endl;
		cout << "Имя: " << Cat1.getName() << endl;
		cout << "Цвет: " << Cat1.getColor() << endl;
		cout << "Порода: " << Cat1.getBreed() << endl;
		cout << "Возраст: " << Cat1.getAge() << " года" << endl;

		cout << "[2] Объект: " << endl;
		cout << "Имя: " << Cat2.getName() << endl;
		cout << "Цвет: " << Cat2.getColor() << endl;
		cout << "Порода: " << Cat2.getBreed() << endl;
		cout << "Возраст: " << Cat2.getAge() << " года" << endl;

		cout << "[3] Объект: " << endl;
		cout << "Имя: " << Cat3.getName() << endl;
		cout << "Цвет: " << Cat3.getColor() << endl;
		cout << "Порода: " << Cat3.getBreed() << endl;
		cout << "Возраст: " << Cat3.getAge() << " лет" << endl;
	}

	
	return 0;
}
