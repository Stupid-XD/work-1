void startGame(PlayerData& player) {
	int attempts = 3;
	int roundScore = 0;
	int correctInThisSession = 0;

	cout << "у вас " << attempts << "попыток" << endl;
	cout << "уровень сложности:" << player.difficulty << endl;

	while (attempts > 0) {

		int num1 = generateRandomNumber(1, 500);
		int num2 = generateRandomNumber(1, 500);

		int difficultyLevel;
		if (player.difficulty == "прибавить") difficultyLevel = 1;
		else if (player.difficulty == "уменьшить") difficultyLevel = 2;
		else difficultyLevel = 3;

		string operation = getOperationSymbol(difficultyLevel);
		int correctAnswer = calculateAnswer(num1, num2, difficultyLevel);

		cout << (3 - attempts + 1) << num1 << operation << num2 << " = ";
		int userAnswer;
		cin >> userAnswer;
		
		if (userAnswer == correctAnswer) {
			int points = calculatePoints(difficultyLevel);
			roundScore += points;
			correctInThisSession++;
			cout << "+" << points << endl; 
		}
		else {
			attempts--;
			cout << "верный ответ: " << correctAnswer << endl;
			if (attempts > 0) {
				cout << "осталось попыток: " << attempts << endl;
 			}
		}
		cout << endl;
	}
	if (attempts == 0) {
		cout << "игра оконяена" << endl;
		cout << "вы решили: " << correctInThisSession << " примеров" << endl;
		cout << "вы набрали: " << roundScore << " очков" << endl;

		player.score += roundScore;
		player.correctAnswers += correctInThisSession;

		cout << "нажмите Enter, чтобы продолжить";
		cin.ignore();
		cin.get();
	}

}

